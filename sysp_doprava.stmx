				<text_box font_weight="bold" font_size="22pt" uid="20" x="480" y="1840" width="400" height="50">Výsledky simulace</text_box>
				<text_box text_align="left" font_size="11pt" uid="21" x="80" y="1905" width="1200" height="65">Níže jsou zobrazeny výstupní časové řady a tabulka hodinových hodnot pro 24 hodin (0–24 h) v Pardubicích. V pravém dolním boxu jsou připraveni „duchové“ (Alias) klíčových parametrů pro rychlé přepínání scénářů a experimentování bez nutnosti vracet se do struktury SFD modelu.</text_box>
				<stacked_container uid="22" x="80" y="1985" width="580" height="310">
					<graph width="580" height="310" type="time_series" show_grid="true" isee:tick_type="none" include_units_in_legend="true" plot_numbers="false" isee:label_pie_slices="false" isee:show_pie_borders="true" num_x_grid_lines="0" num_y_grid_lines="0" num_x_labels="0" num_y_labels="0" isee:fill_intensity="0.1" isee:allow_zero_axis="true" left_axis_multi_scale="true" left_axis_auto_scale="true" left_include_units="true" right_axis_multi_scale="true" right_axis_auto_scale="true" right_include_units="true">
						<plot color="red" isee:keep_zero_visible="true" pen_width="2" index="0" show_y_axis="true">
							<entity name="Active_Traffic_Incidents"/>
						</plot>
						<plot color="blue" pen_style="dashed" isee:keep_zero_visible="true" pen_width="2" index="0" right_axis="true" show_y_axis="true">
							<entity name="actualAverageSpeed"/>
						</plot>
					</graph>
				</stacked_container>
				<stacked_container uid="23" x="690" y="1985" width="590" height="310">
