	<ai_information>
		<status verified="false" trusted="false" tampered="false" uses="false" analyzed="false" log_truncated="false" timestamp="1795471875" algorithm="ed25519" keyurl="https://iseesystems.com/keys/stella01.txt" want_var_info="true" want_var_status="false" want_log="false" sampling="1" signature="zm/UrGIbNsdAsBI70GyJLFRd/jAznIdJJzXSQ4uL/q+ZeABjb5pL/7iMdy3J1oTfomzwauGLkJg8wqELzTHVAA=="/>
	</ai_information>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.0625" isee:restore_on_start="false" method="Euler" time_units="Hours" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>0</start>
		<stop>24</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Citlivost_Doba_Odklizeni_IZS" method="multivariate" runs="5">
			<isee:variable starting_value="0.3" ending_value="1.2" type="incremental" min="0.3" max="1.2" seed="12345" name="avgIncidentClearanceTime" num_samples="5"/>
		</isee:sensi_specs>
		<isee:sensi_specs name="Citlivost_Podil_Elektromobilu" method="multivariate" runs="5">
			<isee:variable starting_value="0.012" ending_value="0.5" type="incremental" min="0.012" max="0.5" seed="12345" name="evFleetShare" num_samples="5"/>
		</isee:sensi_specs>
	</isee:sensi_specs_list>
	<model_units>
		<unit name="Hours">
			<eqn/>
			<alias>hr</alias>
			<alias>hour</alias>
		</unit>
		<unit name="vehicle">
			<eqn/>
			<alias>vehicles</alias>
		</unit>
		<unit name="incident">
			<eqn/>
			<alias>incidents</alias>
		</unit>
		<unit name="kg">
			<eqn/>
			<alias>Kilograms</alias>
		</unit>
		<unit name="km">
			<eqn/>
			<alias>kilometers</alias>
		</unit>
		<unit name="mm">
			<eqn/>
			<alias>millimeters</alias>
		</unit>
		<unit name="min">
			<eqn/>
			<alias>Minutes</alias>
		</unit>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="vehiclesInTraffic">
				<doc>Tymova hladina z projekt.stmx: aktualni pocet aktivnich vozidel v silnicni siti Pardubic (pocatecni stav 200 vozidel o pulnoci).</doc>
				<eqn>200</eqn>
				<inflow>vehiclesEntering</inflow>
				<outflow>vehiclesLeaving</outflow>
				<non_negative/>
				<units>vehicle</units>
			</stock>
			<stock name="Active Traffic Incidents">
				<doc>Aktualni pocet aktivnich dopravnich nehod a poruch blokujicich jizdni pruhy v Pardubicich (zdroj: Policie CR, PUMM Pardubice, CKP, FHWA/ASCE).</doc>
				<eqn>0</eqn>
				<inflow>Incident_Occurrence_Rate</inflow>
				<outflow>Incident_Clearance_Rate</outflow>
				<non_negative/>
				<units>incident</units>
			</stock>
			<stock name="Cumulative CO2 Emissions">
				<doc>Kumulativni emise CO2 ze silnicni dopravy v Pardubicich za 24 hodin v kg CO2 (zdroj: EMEP/EEA Guidebook 2023/2025 COPERT, CDV, CSD 2020).</doc>
				<eqn>0</eqn>
				<inflow>CO2_Emission_Rate</inflow>
				<non_negative/>
				<units>kg</units>
			</stock>
			<flow name="vehiclesEntering">
				<doc>Hodinovy pritok vozidel do silnicni site Pardubic dle denni variace mistnich komunikaci (metodika TP 189) a dat CSD 2020 / PUMM Pardubice.</doc>
				<eqn>dailyTripsPardubice * dailyTrafficShareTP189</eqn>
				<non_negative/>
				<units>vehicle/Hours</units>
			</flow>
			<flow name="vehiclesLeaving">
				<doc>Hodinovy odtok vozidel ze site dle Littleova zakona (aktualni rychlost / prumerna delka jizdy 12 km).</doc>
				<eqn>vehiclesInTraffic * (actualAverageSpeed / avgTripLengthKm)</eqn>
				<non_negative/>
				<units>vehicle/Hours</units>
			</flow>
			<flow name="Incident Occurrence Rate">
				<doc>Rychlost vzniku novych dopravnich incidentu (nehody + poruchy blokujici pruhy) v zavislosti na provozu, desti a kongesci.</doc>
				<eqn>vehiclesInTraffic * baseAccidentRate * weatherAccidentMultiplier * congestionIncidentFactor</eqn>
				<non_negative/>
				<units>incident/Hours</units>
			</flow>
			<flow name="Incident Clearance Rate">
				<doc>Rychlost uvolnovani komunikaci slozkami IZS a odtahovou sluzbou (prumerna doba odstraneni 0,65 h = 39 min dle FHWA TIM / ASCE).</doc>
				<eqn>Active_Traffic_Incidents / avgIncidentClearanceTime</eqn>
				<non_negative/>
				<units>incident/Hours</units>
			</flow>
			<flow name="CO2 Emission Rate">
				<doc>Okamzita hodinova produkce emisi CO2 vsech aktivnich vozidel (kg CO2/h) dle COPERT/EMEP-EEA se zohlednenim tezke dopravy, studeneho startu (9,8 C) a elektromobilu.</doc>
				<eqn>vehiclesInTraffic * actualAverageSpeed * speedCO2FactorKgPerKm * (1 + heavyVehicleShare * 1.5) * coldStartTempFactor * (1 - evFleetShare)</eqn>
				<non_negative/>
				<units>kg/Hours</units>
			</flow>
			<aux name="hourOfDay">
				<doc>Aktualni hodina dne (0-24 h), zachovano z tymoveho projekt.stmx.</doc>
				<eqn>TIME MOD 24</eqn>
				<units>Hours</units>
			</aux>
			<aux name="registeredVehicles">
				<doc>Registrovana vozidla v Pardubicich (zachovano z projekt.stmx; CSU 2025: 321,5 tis. OA v kraji).</doc>
				<eqn>73000</eqn>
				<units>vehicle</units>
			</aux>
			<aux name="parkedVehiclesNight">
				<doc>Nocni parkujici vozidla (zachovano z projekt.stmx pro napojeni 4. hladiny parkedVehicles).</doc>
				<eqn>registeredVehicles * 0.65</eqn>
				<units>vehicle</units>
			</aux>
			<aux name="dailyTripsPardubice">
				<doc>Celkovy denni objem jizd v mestske a primestske siti Pardubic (kalibrovano na CSD 2020/2025 a PUMM Pardubice).</doc>
				<eqn>150000</eqn>
				<units>vehicle</units>
			</aux>
			<aux name="dailyTrafficShareTP189">
				<doc>Hodinovy podil denni intenzity dopravy na mistnich komunikacich (metodika TP 189, Tabulka 2).</doc>
				<eqn>hourOfDay</eqn>
				<gf>
					<xscale min="0" max="24"/>
					<yscale min="0" max="0.1"/>
					<ypts>0.002,0.001,0.001,0.002,0.007,0.03,0.0589,0.0789,0.0639,0.0659,0.0659,0.0639,0.0659,0.0699,0.0889,0.0919,0.0739,0.0569,0.042,0.031,0.017,0.011,0.008,0.003,0.002</ypts>
				</gf>
				<units>1/Hours</units>
			</aux>
			<aux name="avgTripLengthKm">
				<doc>Prumerna delka modelovane jizdy v uzlu Pardubice a jeho dojizdkovem zazemi (12 km).</doc>
				<eqn>12</eqn>
				<units>km</units>
			</aux>
			<aux name="freeFlowSpeed">
				<doc>Efektivni volna prujezdna rychlost v mestske siti Pardubic vcetne svetelnych krizovatek (42 km/h).</doc>
				<eqn>42</eqn>
				<units>km/Hours</units>
			</aux>
			<aux name="baseRoadCapacity">
				<doc>Zakladni soucasna kapacita hlavni silnicni site Pardubic za idealnich podminek (5300 vozidel).</doc>
				<eqn>5300</eqn>
				<units>vehicle</units>
			</aux>
			<aux name="effectiveRoadCapacity">
				<doc>Efektivni kapacita silnicni site ponizena o vliv srazek a aktivnich dopravnich incidentu.</doc>
				<eqn>baseRoadCapacity * weatherCapacityFactor * incidentCapacityFactor</eqn>
				<units>vehicle</units>
			</aux>
			<aux name="volumeToCapacityRatio">
				<doc>Pomer zatizeni ke kapacite site (V/C) pro BPR funkci rychlosti.</doc>
				<eqn>vehiclesInTraffic / effectiveRoadCapacity</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="actualAverageSpeed">
				<doc>Aktualni prumerna rychlost dopravy dle BPR rovnice (dolni mez kolony ~5 km/h).</doc>
				<eqn>freeFlowSpeed * MAX(0.12, 1 / (1 + 0.15 * (volumeToCapacityRatio ^ 4)))</eqn>
				<units>km/Hours</units>
			</aux>
			<aux name="minPerHour">
				<doc>Prepocet hodin na minuty pro prisnou kontrolu jednotek (strict_units).</doc>
				<eqn>60</eqn>
				<units>min/Hours</units>
			</aux>
			<aux name="averageCommuteDelayMin">
				<doc>Prumerne zdrzeni na modelove 12km ceste oproti volnemu prujezdu (v minutach).</doc>
				<eqn>((avgTripLengthKm / actualAverageSpeed) - (avgTripLengthKm / freeFlowSpeed)) * minPerHour</eqn>
				<units>min</units>
			</aux>
			<aux name="hourlyPrecipitationMm">
				<doc>Hodinovy uhrn srazek (mm/h). Scenar 1: prumerny den roku v Pardubicich dle CHMU H3PARD01 (554,8 mm/rok = 1,52 mm/den = 0,0633 mm/h). Pro Scenar 2 nahradte profilem deste (23,2 mm/den).</doc>
				<eqn>hourOfDay</eqn>
				<gf>
					<xscale min="0" max="24"/>
					<yscale min="0" max="6"/>
					<ypts>0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633,0.0633</ypts>
				</gf>
				<units>mm/Hours</units>
			</aux>
			<aux name="rainCapacitySensitivity">
				<doc>Citlivost poklesu kapacity silnice na intenzitu deste (zdroj: FHWA Road Weather Management, pokles 10-30 % pri silnem desti).</doc>
				<eqn>0.055</eqn>
				<units>Hours/mm</units>
			</aux>
			<aux name="weatherCapacityFactor">
				<doc>Koeficient zachovane kapacity silnic za deste (min. 0,72 pri silnem desti dle FHWA).</doc>
				<eqn>1 - MIN(0.28, hourlyPrecipitationMm * rainCapacitySensitivity)</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="rainAccidentSensitivity">
				<doc>Citlivost narustu rizika nehod na intenzitu srazek (zdroj: PMC 2025 RRF=1,38 v desti; FHWA).</doc>
				<eqn>0.16</eqn>
				<units>Hours/mm</units>
			</aux>
			<aux name="weatherAccidentMultiplier">
				<doc>Nasobitel rizika vzniku incidentu vlivem deste a mokre vozovky (max. 1,85x).</doc>
				<eqn>1 + MIN(0.85, hourlyPrecipitationMm * rainAccidentSensitivity)</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="baseAccidentRate">
				<doc>Zakladni mira incidentu (nehody + poruchy blokujici pruh) na vozohodinu v Pardubicich (kalibrovano na PUMM 742 nehod/rok, CKP 3,1x, ASCE).</doc>
				<eqn>0.00013</eqn>
				<units>incident/(vehicle*Hours)</units>
			</aux>
			<aux name="congestionIncidentFactor">
				<doc>Zpetnovazebni vliv hustoty provozu (V/C &gt; 0,6) na vznik sekundarnich kolizi a poruch v kolonach.</doc>
				<eqn>1 + MIN(0.45, MAX(0, (volumeToCapacityRatio - 0.6) * 0.45))</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="avgIncidentClearanceTime">
				<doc>Prumerna doba uvolneni vozovky po incidentu: 0,65 h = 39 min (FHWA RCT 36,2 min, ASCE 36,7 min, ICT 54,8 min).</doc>
				<eqn>0.65</eqn>
				<units>Hours</units>
			</aux>
			<aux name="capacityLossPerIncident">
				<doc>Modelovy koeficient poklesu prujezdne kapacity mestske site na 1 aktivni blokujici incident (agregace z HCM Exhibit 10-17).</doc>
				<eqn>0.16</eqn>
				<units>1/incident</units>
			</aux>
			<aux name="incidentCapacityFactor">
				<doc>Koeficient zachovane kapacity site pri aktivnich dopravnich incidentech.</doc>
				<eqn>1 / (1 + capacityLossPerIncident * Active_Traffic_Incidents)</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="speedCO2FactorKgPerKm">
				<doc>Kalibrovana aproximace U-krivky emisniho faktoru CO2 osobniho vozidla v CR (kg CO2/vozokm) pro 5-60 km/h (EMEP/EEA Guidebook 2023/2025 COPERT, stari parku 15,9-16,4 let).</doc>
				<eqn>actualAverageSpeed</eqn>
				<gf>
					<yscale min="0.05" max="0.15"/>
					<xpts>5,10,15,20,25,30,40,50,60</xpts>
					<ypts>0.46,0.325,0.265,0.225,0.198,0.182,0.162,0.152,0.15</ypts>
				</gf>
				<units>kg/(vehicle*km)</units>
			</aux>
			<aux name="heavyVehicleShare">
				<doc>Podil tezkych a uzitkovych vozidel v mestskem provozu Pardubic (zdroj: CSD 2020: II/324 8,1 %, I/37 17,2-20,2 %, prumer mesta 12 %).</doc>
				<eqn>0.12</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="coldStartTempFactor">
				<doc>Korekce studenych startu pro prumernou rocni teplotu Pardubic 9,8 C (CHMU H3PARD01) dle EMEP/EEA pri podilu 20 % studene jizdy: 1 + 0,20*(1,47 - 0,009*9,8 - 1) = 1,076.</doc>
				<eqn>1.076</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="evFleetShare">
				<doc>Podil ciste elektrickych vozidel (BEV) ve vozovem parku CR k 10/2026: ~82 tis. z 6,8 mil. = 1,2 % (zdroj: CDV Cista doprava).</doc>
				<eqn>0.012</eqn>
				<units>Dimensionless</units>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
